.address-bar { margin: 4rpx 0 32rpx; }.address-kicker { font-size: 21rpx; color: #899482; }.address-name { font-size: 33rpx; font-weight: 700; margin: 5rpx 0; }.brand-mark { height: 82rpx; width: 82rpx; border-radius: 26rpx; background: #236746; color: #e5efb7; text-align: center; line-height: 82rpx; font-size: 38rpx; font-weight: 700; transform: rotate(-6deg); }
.hero { background: #e8edda; border-radius: 32rpx; min-height: 320rpx; padding: 40rpx 32rpx; position: relative; overflow: hidden; }.hero-copy { position: relative; z-index: 2; }.eyebrow { font-size: 21rpx; color: #6e815c; letter-spacing: 2rpx; }.hero-title { font-size: 44rpx; font-weight: 700; line-height: 1.4; margin: 18rpx 0; letter-spacing: -1rpx; }.hero-sub { font-size: 22rpx; color: #748563; }
.bag-art { position: absolute; right: 35rpx; top: 60rpx; width: 150rpx; height: 220rpx; transform: rotate(9deg); }.bag-body { position: absolute; bottom: 23rpx; width: 140rpx; height: 145rpx; border-radius: 40% 40% 25% 25%; background: #6c8754; box-shadow: inset -17rpx -5rpx 0 #587745; }.bag-knot { width: 65rpx; height: 45rpx; position: absolute; top: 17rpx; left: 42rpx; background: #91a46d; border-radius: 10rpx 10rpx 40rpx 40rpx; transform: rotate(-8deg); }.bag-smile { color: #f2f4d5; text-align: center; font-size: 72rpx; height: 88rpx; line-height: 1; }.bag-label { color: #e3ebc9; text-align: center; font-size: 17rpx; }.bag-shadow { height: 16rpx; width: 160rpx; background: #ced7b9; border-radius: 50%; position: absolute; bottom: 0; }.spark { position: absolute; top: -35rpx; right: -5rpx; color: #a0b06f; font-size: 45rpx; }
.slot { display: flex; justify-content: space-between; align-items: center; border: 2rpx solid #e6ebdf; border-radius: 26rpx; padding: 25rpx; margin-bottom: 18rpx; background: white; }.slot.selected { border-color: #477854; background: #f1f5e9; }.slot.disabled { opacity: .58; }.slot-symbol { width: 80rpx; height: 80rpx; background: #fff4d8; color: #b48d3d; line-height: 80rpx; text-align: center; border-radius: 24rpx; font-size: 40rpx; margin-right: 23rpx; }.slot-symbol.night { background: #ecefe5; color: #6e7e57; }.slot-title { font-size: 30rpx; font-weight: 600; }.slot-deadline { font-size: 21rpx; color: #8b9682; margin-top: 3rpx; }.slot-right { display: flex; align-items: flex-end; flex-direction: column; }.slot-price { font-size: 24rpx; color: #526947; }.selection-dot { margin-top: 12rpx; border: 2rpx solid #dbe1d3; width: 36rpx; height: 36rpx; border-radius: 50%; font-size: 23rpx; text-align: center; line-height: 33rpx; }.selected .selection-dot { background: #236746; color: white; border-color: #236746; }
.remark-card .input-label { margin-top: 0; }.remark-card input { font-size: 25rpx; min-height: 50rpx; }.member-note { color: #527447; background: #edf1e2; font-size: 23rpx; padding: 20rpx; border-radius: 16rpx; margin-top: 24rpx; }.membership-teaser { margin-top: 32rpx; padding: 30rpx; border-radius: 28rpx; background: #e9eeda; }.teaser-title { font-size: 29rpx; font-weight: 700; margin: 9rpx 0; }.teaser-price { font-size: 49rpx; color: #4a633c; font-weight: 650; }.teaser-price .small-text { font-weight: 400; margin-top: 10rpx; }.footnote { text-align: center; font-size: 22rpx; color: #9ba590; margin-top: 35rpx; }.setup,.intro-card button { margin-top: 28rpx; }.intro-card { margin-top: 24rpx; }.intro-card .section-title { margin-top: 0; }.bottom-bar .price { font-size: 43rpx; margin-top: 7rpx; }

.date-hint { font-size: 23rpx; color: #7d8176; margin: -8rpx 0 20rpx; }
.date-scroll { width: 100%; margin-bottom: 22rpx; white-space: nowrap; }
.date-list { display: flex; gap: 12rpx; padding: 2rpx 0 10rpx; }
.date-item { flex-shrink: 0; width: 88rpx; padding: 20rpx 0; text-align: center; border-radius: 20rpx; background: #fff; border: 2rpx solid #e8e9e1; color: #555e50; }
.date-active { background: #236746; border-color: #236746; color: #fff; }
.date-label { font-size: 26rpx; font-weight: 600; }
.date-number { font-size: 22rpx; margin-top: 10rpx; opacity: .8; }
.date-locked { opacity: .6; }
.slot-count { color: #236746; font-size: 24rpx; margin-top: 10rpx; }
.slot-hold { font-size: 21rpx; color: #8c8063; margin-top: 5rpx; }
