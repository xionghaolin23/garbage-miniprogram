.member-hero { padding: 38rpx; border-radius: 32rpx; background: #254c37; color: #f2f4dc; min-height: 425rpx; position: relative; overflow: hidden; margin-bottom: 28rpx; }.member-kicker { font-size: 23rpx; color: #c4d3a9; position: relative; z-index: 1; }.member-headline { font-size: 46rpx; font-weight: 650; line-height: 1.45; margin: 23rpx 0; position: relative; z-index: 1; }.member-price { font-size: 30rpx; position: relative; z-index: 1; }.member-price > text { font-size: 90rpx; font-weight: 650; line-height: 1.2; }.member-price > text.duration { font-size: 25rpx; color: #bac9a5; font-weight: 400; }.member-foot { margin-top: 15rpx; font-size: 23rpx; color: #bccca6; }.orbit { border: 1rpx solid #527149; border-radius: 50%; position: absolute; width: 450rpx; height: 450rpx; right: -215rpx; top: 40rpx; }.orbit-two { width: 300rpx; height: 300rpx; right: -140rpx; top: 110rpx; background: #365a3c; }.no-margin { margin: 0; }.current-member button { margin-top: 20rpx; }.member-dates { margin-top: 20rpx; color: #658057; font-size: 26rpx; }.benefit { display: flex; align-items: flex-start; gap: 21rpx; margin: 20rpx 0 28rpx; }.benefit:last-child { margin-bottom: 12rpx; }.tick { background: #edf2e4; color: #6c8656; padding: 2rpx 13rpx; border-radius: 12rpx; }.benefit > view > view { font-weight: 600; margin-bottom: 7rpx; }.range { font-size: 30rpx; font-weight: 600; margin: 20rpx 0; }.range text { font-size: 24rpx; color: #91a083; font-weight: 400; }.price-unit { font-size: 26rpx; }.bottom-bar .price { margin-top: 8rpx; }
