.detail-status { text-align: center; padding: 15rpx 10rpx 40rpx; }.status-orb { margin: 0 auto 20rpx; width: 100rpx; height: 100rpx; border-radius: 50%; background: #edf0df; color: #728450; font-size: 53rpx; line-height: 100rpx; }.status-orb.completed { background: #dfebd9; color: #367146; }.status-orb.exception { background: #f9e9dd; color: #a47345; }.detail-status .title { font-size: 39rpx; }.no-margin { margin: 0; }.time-large { font-size: 43rpx; font-weight: 650; margin: 20rpx 0 5rpx; }.address-title { font-weight: 650; font-size: 30rpx; margin-bottom: 6rpx; }.action { margin-bottom: 20rpx; }.photo { width: 100%; border-radius: 20rpx; margin-top: 20rpx; }.meta { padding: 22rpx; overflow-wrap: anywhere; }
