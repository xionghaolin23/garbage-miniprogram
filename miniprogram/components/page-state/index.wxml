<view wx:if="{{loading}}" class="state"><view class="dot"></view><text>正在加载…</text></view>
<view wx:elif="{{error}}" class="state"><text class="state-title">暂时没能加载出来</text><text class="state-copy">{{error}}</text><button bindtap="retry">重新加载</button></view>
<view wx:elif="{{empty}}" class="state"><view class="empty-circle">✓</view><text class="state-copy">{{message}}</text></view>
